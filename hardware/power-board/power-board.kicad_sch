	(text "weatherstation power board: block diagram" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 2.0 2.0)) (justify left top)) (uuid "9e9e2bb8-15fc-55f6-a3de-d7579ee85ec8"))
	(text "Each box is a sheet. Wires join the sheet pins (hierarchical labels). Rails (GND, SYS, VBUS, USB_VBUS, PMID, REGN, BAT_PACK) are power symbols." (exclude_from_sim no) (at 15.24 25.4 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "b4a0702a-85e0-5de2-bb00-5eaca7036e15"))
	(text "Power path: USB_VBUS (J10, from the main board's USB-C) or PV (J5) -> Inputs (ACFET/RBFET pairs) -> VBUS -> Charger (BQ25798) -> SYS -> J10 -> main board." (exclude_from_sim no) (at 15.24 233.68 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "52a6e748-6301-5316-9139-a6cc9524dda6"))
	(text "Cell: Battery (J6, PTC F1, HY2112-CB with M60/M61) <-> BAT_PACK <-> Charger. The board makes no 3.3 V: CE/INT/I2C pull-ups are on the main board." (exclude_from_sim no) (at 15.24 238.76 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "3ca65610-fc9c-5a17-8d4e-0ef4c3e86614"))
	(text "Header J10 (J_PWR) pin map and the D+/D- decision: hardware/ARCHITECTURE.md. Open decisions: hardware/power-board/PARTS-REVIEW.md." (exclude_from_sim no) (at 15.24 243.84 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "decf7916-a1b0-5984-8bdd-dd5e55cabe4a"))
	(text "Brings in USB_VBUS (from the main board over J10)" (exclude_from_sim no) (at 19.05 49.53 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "73b96e77-b564-5166-9bd5-8d974f40177f"))
	(text "and the solar panel (J5). Surge TVS and EMI choke on" (exclude_from_sim no) (at 19.05 54.61 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "2d8a1a4c-01f2-5414-a43d-ac640a196345"))
	(text "PV; two back-to-back FET pairs select the source" (exclude_from_sim no) (at 19.05 59.69 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "e1fee430-7c8a-5310-b67d-9c732b5dd687"))
	(text "into VBUS." (exclude_from_sim no) (at 19.05 64.77 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "e0fc94a5-0ec8-55dd-af12-78f55e58fdcc"))
	(text "BQ25798 charger: turns VBUS (USB or solar) into" (exclude_from_sim no) (at 146.05 49.53 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "5f5f7519-accf-586b-b3a2-8a5149b99b74"))
	(text "battery charge current and SYS power. Programmed" (exclude_from_sim no) (at 146.05 54.61 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "09d14355-2c0f-5816-b73f-197aabaee594"))
	(text "over I2C by the main board: 1S, 1.5 MHz, 3.65 V, 1.5" (exclude_from_sim no) (at 146.05 59.69 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "0d6bf917-325b-5ab3-be59-d290e70a3460"))
