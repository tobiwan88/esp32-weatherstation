	(rectangle (start 15.24 25.4) (end 259.08 137.16) (stroke (width 0.3) (type dash) (color 90 90 90 1)) (fill (type color) (color 225 225 225 0.35)) (uuid "feb56c7b-e173-5ff7-a7d3-05b05503f0e5"))
	(text "Board-to-board header J10 (J_PWR)" (exclude_from_sim no) (at 16.51 26.42 0) (effects (font (size 1.5 1.5) bold) (justify left top)) (uuid "fb01e483-e617-5313-9968-74e3f866a0aa"))
	(text "Keyed 2x10 2.54 mm socket, hand-soldered, hole 3 blocked (key). SYS out (pins 1, 2, >= 1 A), USB_VBUS in (19, 20), D+/D- in (BC1.2 detection), charger I2C/INT/CE to the main board. A GND pair between signal pairs. Pin map:\nhardware/ARCHITECTURE.md" (exclude_from_sim no) (at 16.51 31.5 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "035b2587-d5f1-50e6-bd6a-a93d27eadcf8"))
	(text "J10 pin map (hardware/ARCHITECTURE.md), keyed 2x10: pin 3 is the key (no pin, hole blocked)\npins 1, 2: SYS, power board -> main board: system rail (cell-referred, 1.8-5.5 V), at least 1 A\npins 4, 5, 6, 9, 10, 13, 14, 17, 18: GND (a GND pair between every signal pair)\npins 7, 8: USB_DP, USB_DN, main -> power: BC1.2 detection only (BQ25798 D+/D-)\npins 11, 12: CHG_SDA, CHG_SCL: charger I2C (address 0x6B), 10k pull-ups on the main board\npin 15: CHG_INT, power -> main: open drain, 10k pull-up on the main board\npin 16: CHG_CE, main -> power: active low, pulled high (charge off) until firmware drives it low\npins 19, 20: USB_VBUS, main -> power: USB-C VBUS to ACFET1 drain and VAC1\nRotated, mirrored or column-shifted plugs hit the key (tools/header_check.py). No 3.3 V on the power board." (exclude_from_sim no) (at 116.84 45.72 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "06a05102-90e8-5ae9-a46a-7034dc51e643"))
	(hierarchical_label "USB_DP" (shape output) (at 55.88 73.66 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "8449aae5-71ec-5e32-ab6d-24fe13f5fdbd"))
	(hierarchical_label "USB_DN" (shape output) (at 78.74 73.66 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "19189ca5-8407-579e-ae84-7b8e605042dd"))
	(hierarchical_label "CHG_CE" (shape output) (at 78.74 83.82 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "2a0eb40b-1b6e-52bc-a78a-af436a3795a2"))
