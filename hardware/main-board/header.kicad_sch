	(rectangle (start 15.24 25.4) (end 193.04 142.24) (stroke (width 0.3) (type dash) (color 90 90 90 1)) (fill (type color) (color 225 225 225 0.35)) (uuid "bed62e74-06ff-5bb7-a7d3-73766a5ec96a"))
	(text "Board-to-board header J10 (J_PWR) and charger host pull-ups" (exclude_from_sim no) (at 16.51 26.42 0) (effects (font (size 1.5 1.5) bold) (justify left top)) (uuid "b30bab7c-b279-5b6e-afb1-29427aad496a"))
	(text "J10 mating side (pin map: hardware/ARCHITECTURE.md). +3V3 lives here: CE pull-up R20 1M (charge off until firmware writes VREG; the power board has its own 1M), INT R22 10k, charger I2C R54/R55 10k (BQ25798 table 5-1)" (exclude_from_sim no) (at 16.51 31.5 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "7d5071a8-7f57-5a64-8763-99ffa6ff9f63"))
	(text "J10 pin map (hardware/ARCHITECTURE.md), keyed 2x10: pin 3 is the key (no pin, hole blocked)\npins 1, 2: SYS, power board -> main board: system rail (cell-referred, 1.8-5.5 V), at least 1 A\npins 4, 5, 6, 9, 10, 13, 14, 17, 18: GND (a GND pair between every signal pair)\npins 7, 8: USB_DP, USB_DN, main -> power: BC1.2 detection only (BQ25798 D+/D-)\npins 11, 12: CHG_SDA, CHG_SCL: charger I2C (address 0x6B), 10k pull-ups on the main board\npin 15: CHG_INT, power -> main: open drain, 10k pull-up on the main board\npin 16: CHG_CE, main -> power: active low, pulled high (charge off) until firmware drives it low\npins 19, 20: USB_VBUS, main -> power: USB-C VBUS to ACFET1 drain and VAC1\nRotated, mirrored or column-shifted plugs hit the key (tools/header_check.py). No 3.3 V on the power board." (exclude_from_sim no) (at 25.4 99.06 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "766680d9-d41e-5256-9a38-582e86f54aaf"))
	(hierarchical_label "USB_DP" (shape bidirectional) (at 71.12 73.66 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "501f947f-1fab-51f4-b0e8-c09d34de20da"))
	(hierarchical_label "USB_DN" (shape bidirectional) (at 93.98 73.66 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1604830d-7e14-562a-bd89-422655dbc0ce"))
