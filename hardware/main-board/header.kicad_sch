	(hierarchical_label "CHG_INT" (shape bidirectional) (at 30.48 83.82 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "6f78ccb1-46f2-57d7-9b2f-8d99857ac5e6"))
