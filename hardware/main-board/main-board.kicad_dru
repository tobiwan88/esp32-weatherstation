(version 1)
# Custom DRC rules for the main board (copied by hardware/gen/pcbkit.py next to the board). From weatherstation.kicad_dru (v1).
# No vias in SMD pads: open vias wick solder (LGA/QFN opens, 0402 tombstones); JLC via-in-pad costs extra.
(rule "no via in SMD pad"
  (constraint physical_clearance (min 0.1mm))
  (condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD'"))
# A via on the same net as an SMD pad keeps >= 0.15 mm copper to the pad (physical_clearance also sees same-net copper).
(rule "via to same-net SMD pad"
  (constraint physical_clearance (min 0.15mm))
  (condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD' && A.NetName == B.NetName"))
# Vias keep 0.35 mm from the board edge (JLC copper-to-edge 0.2 mm; project copper 0.3 mm).
(rule "via to board edge"
  (constraint edge_clearance (min 0.35mm))
  (condition "A.Type == 'Via'"))
# Plated through-hole annular ring >= 0.15 mm (JLC minimum for PTH pads).
(rule "THT pad annular ring"
  (constraint annular_width (min 0.15mm))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))
# Silkscreen text at least 0.8 mm high (JLC minimum).
(rule "silk text height"
  (constraint text_height (min 0.8mm))
  (condition "A.Type == 'Text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')"))
# Power path (SYS, USB_VBUS, 5V_SW, switch nodes): at least 0.3 mm where it necks into a pin (class 0.65 mm).
(rule "power path neck"
  (constraint track_width (min 0.3mm))
  (condition "A.Type == 'Track' && A.hasNetclass('Power')"))
# The USB-C shell is metal and grounded: no signal copper under it (rule area "j1_shell" in main_pcb.py).
(rule "no signal copper under the J1 shell"
  (constraint disallow track via)
  (condition "A.NetName != 'GND' && A.intersectsArea('j1_shell')"))
# No tracks or vias under L4/L5 on B.Cu (REQUIREMENTS E3) and none under the BMP580 (BST-BMP581-DS004-13 8.2): rule areas
# in main_pcb.py, no custom rule needed. Antenna: the module footprint's own keepout lies off the board (overhang).
# USB pair (net class USB, clearance 0.6 mm to other nets' copper): the pair's own gap is 0.15 mm (90 ohm, calc/impedance.py)
(rule "USB pair gap"
  (constraint clearance (min 0.15mm))
  (condition "A.NetClass == 'USB' && B.NetClass == 'USB'"))
# Pads keep the normal clearance to the pair (connector, ESD and resistor pins have their own pitch); so does every item
# inside the J1/U4 fan-out (rule area "usb_fanout" in main_pcb.py: 0.5 mm connector pitch, U4 VBUS via between the lines)
(rule "USB to pads and fan-out"
  (constraint clearance (min 0.15mm))
  (condition "A.NetClass == 'USB' && (B.Type == 'Pad' || A.intersectsArea('usb_fanout'))"))
# The GND planes keep their normal antipad (zone clearance 0.25 mm) around the pair's own vias
(rule "USB to inner planes"
  (constraint clearance (min 0.25mm))
  (condition "A.NetClass == 'USB' && B.Type == 'Zone' && (B.Layer == 'In1.Cu' || B.Layer == 'In2.Cu')"))
# Outer GND pours (tools/main_stitch.py): a GND pad that already has its own track or via may resolve to a single
# thermal spoke where routing crowds it (U2 pins 3/8, U7 pin 4, the J1/J2/J10/J11 shield pins).
(rule "single spoke"
  (constraint min_resolved_spokes 1)
  (condition "A.Type == 'Zone' && A.NetName == 'GND'"))
