	(text "UART0 header J7: 1 +3V3, 2 TXD0 (IO43), 3 RXD0 (IO44), 4 GND" (exclude_from_sim no) (at 224.79 122.94 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "86db8a3f-6434-5a89-ad7d-3287faf4be9c"))
