	(text "ESP32-S3-WROOM-1-N8" (exclude_from_sim no) (at 16.51 26.42 0) (effects (font (size 1.5 1.5) bold) (justify left top)) (uuid "2c4de5b5-343a-573f-8438-fbb17f499f3f"))
	(text "N8: 8 MB flash, no PSRAM. Strapping: IO0 (BOOT), EN (RESET). Native USB on IO19/IO20 with 22 ohm series resistors. Open pins (no-connect flags): IO3, IO45, IO46 are strapping pins left at\ntheir defaults; IO35-IO37 stay free (octal PSRAM on N8R8 modules); IO21, IO38-IO40, IO47, IO48 spare" (exclude_from_sim no) (at 16.51 31.5 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "bca19e78-9e19-5b3c-a4fe-58bb3581ec21"))
	(rectangle (start 223.52 25.4) (end 325.12 101.6) (stroke (width 0.3) (type dash) (color 100 50 160 1)) (fill (type color) (color 225 210 248 0.35)) (uuid "8681d42d-97b3-5c45-959a-c4d355c9261c"))
	(text "Reset and boot" (exclude_from_sim no) (at 224.79 26.42 0) (effects (font (size 1.5 1.5) bold) (justify left top)) (uuid "2f3ec6c6-7c4f-59ab-b40b-f0e3dcd190f5"))
	(text "EN: RC delay 10k / 1 uF, RESET tweezer pads JP1. IO0: 10k pull-up, BOOT pads JP2 (short BOOT, then\nRESET = download mode)" (exclude_from_sim no) (at 224.79 31.5 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "09227ed3-a42f-5bb7-b47e-f4840ca6a269"))
	(rectangle (start 223.52 116.84) (end 325.12 193.04) (stroke (width 0.3) (type dash) (color 100 50 160 1)) (fill (type color) (color 225 210 248 0.35)) (uuid "39ef2a2c-bbff-5620-98eb-f2a707c9ef70"))
	(text "Debug UART" (exclude_from_sim no) (at 224.79 117.86 0) (effects (font (size 1.5 1.5) bold) (justify left top)) (uuid "733e5714-9bbc-5f37-8e08-96223677bb76"))
	(text "UART0 header J7: 1 +3V3, 2 TXD0 (IO43), 3 RXD0 (IO44), 4 GND" (exclude_from_sim no) (at 224.79 122.94 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "86db8a3f-6434-5a89-ad7d-3287faf4be9c"))
