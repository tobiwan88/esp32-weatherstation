	(text "SYS -> TPS61023 5 V boost -> 5V_SW. Cell: Battery (HY2112, PTC) <-> BAT_PACK <-> Charger. Rails (GND, +3V3, SYS, VBUS, ...) are power symbols on each sheet, not wires here." (exclude_from_sim no) (at 15.24 248.92 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "ab2fd8a2-035b-55cd-af9f-a56eac6c3b41"))
